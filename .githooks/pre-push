#!/usr/bin/env bash
#
# Tracked pre-push gate. Enable it once per clone:
#
#   git config core.hooksPath .githooks
#   git config promptguard.pushGate true    # optional: also run `make ci`
#
set -euo pipefail

# ~/.zshrc is zsh syntax and breaks when sourced from bash -- name the toolchain
# paths it would have added instead. The newest installed nvm node is found,
# not named: a pinned version directory breaks the hook on every node upgrade.
nvm_bin=""
if [ -d "$HOME/.nvm/versions/node" ]; then
  nvm_bin=$(find "$HOME/.nvm/versions/node" -mindepth 2 -maxdepth 2 -name bin -type d | sort -V | tail -n 1)
fi
export PATH="$HOME/.cargo/bin:${nvm_bin:+$nvm_bin:}$HOME/Library/pnpm:$HOME/Library/pnpm/bin:/opt/homebrew/opt/python@3.13/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"

# Agent files load and resolve, and no em or en dashes: the same step as CI.
python3 scripts/check_agent_files.py --check
python3 scripts/check_no_dashes.py --check
# The MCP tool manifest copy is the platform's, byte for byte: compared with a
# sibling platform checkout, which CI does not have (scripts/check_mcp_tool_manifest.py).
python3 scripts/check_mcp_tool_manifest.py --check

# A missing scanner fails the push: a gate that passes when its tool is absent
# looks exactly like a clean scan. One-off override, written down per push:
#   git -c promptguard.skipGitleaks=true push
if ! command -v gitleaks >/dev/null 2>&1; then
  if [ "$(git config --bool promptguard.skipGitleaks 2>/dev/null || echo false)" = "true" ]; then
    echo "pre-push: gitleaks not installed; secret scan SKIPPED by promptguard.skipGitleaks." >&2
  else
    echo "pre-push: gitleaks is not installed, so the secret scan cannot run." >&2
    echo "  brew install gitleaks    (or, once: git -c promptguard.skipGitleaks=true push)" >&2
    exit 1
  fi
fi

# Set by pre-commit at the pre-push stage. Falling back to "everything not yet
# on a remote" covers a direct hook invocation and a brand-new branch alike.
from_ref="${PRE_COMMIT_FROM_REF:-}"
to_ref="${PRE_COMMIT_TO_REF:-}"
if [ -n "$from_ref" ] && ! git rev-parse --quiet --verify "$from_ref" >/dev/null 2>&1; then
  from_ref=""
fi

if [ -n "$from_ref" ] && [ -n "$to_ref" ]; then
  log_opts="$from_ref..$to_ref"
else
  log_opts="HEAD --not --remotes"
fi

if ! gitleaks detect --source . --log-opts "$log_opts" --no-banner --redact; then
  cat >&2 <<'MSG'

A secret was found in the commits you are pushing.

This repository is public. A credential that lands on the default branch is
world-readable immediately and must be rotated, not just reverted.

If this is a test fixture, do not bypass -- give it an obviously-fake shape, or
add its path to .gitleaks.toml so the exemption is written down and reviewable.

Bypass (last resort): git push --no-verify
MSG
  exit 1
fi

# `make ci` is fmt-check + clippy -D warnings + test + build: minutes on a Rust
# workspace. Worth it before a push to main, too slow to impose on every branch
# push, so it is opt-in. The secret scan above is not -- that one is 50ms.
if [ "$(git config --bool promptguard.pushGate 2>/dev/null || echo false)" = "true" ]; then
  echo "pre-push: promptguard.pushGate is on -- running 'make ci'..." >&2
  start=$(date +%s)
  make ci
  echo "pre-push gate passed in $(( $(date +%s) - start ))s -- pushing." >&2
fi
